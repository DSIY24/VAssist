# Copy to .env.local in the repo root. Every package reads that one file.

# Neon Postgres. Pooled connection, used by the app at runtime.
DATABASE_URL=
# Direct connection, used only by the Prisma CLI for migrations.
DATABASE_URL_UNPOOLED=
# The Neon branch these values belong to (development or production).
NEON_BRANCH=

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
